# Copy to .env and fill in. `npm start` reads it (Node's --env-file). There are deliberately NO
# defaults for the backend, the workspace or the secret key: the server refuses to start without them.

# PortableMind API origin. Production: https://www.dsiloed.com   Staging: https://dev.dsiloed.com
PM_API=

# Where the PortableMind web app is served — the target of white-label sign-on (/sso).
# Production: https://app.portablemind.ai   Staging: https://app-dev.portablemind.ai
# Leave empty to switch the "Open PortableMind" lane off.
PM_APP_URL=

# Your network's own Enterprise workspace identifier (the parent of every accelerator).
NETWORK_WORKSPACE=

# Display name used in the UI.
NETWORK_NAME=Launchpad Network

# 32-byte key (64 hex chars) that encrypts data/secrets.enc — the per-accelerator provisioning keys,
# sign-on keys and invite codes. Generate with:  openssl rand -hex 32
# Losing it means re-creating those secrets (rotate the sign-on keys, replace the provisioning keys).
SECRET_STORE_KEY=

# This app's public origin, e.g. https://network.example.com. Used as the sign-on return URL, and an
# https value turns on Secure cookies. Its host belongs in each accelerator's return_url_allowlist.
PUBLIC_URL=

PORT=8080

# Founders confirm their email (platform activation link) before they can sign in. Default: on.
# Turn off ONLY for staging demos — without it anyone can register under someone else's address.
# FOUNDER_EMAIL_VERIFICATION=on

# Behind a reverse proxy: take the client address from X-Forwarded-For (for rate limits).
# TRUST_PROXY=1

# Optional tuning
# DATA_DIR=./data
# BACKEND_TIMEOUT_MS=15000
# SESSION_IDLE_HOURS=12
# REFRESH_EVERY_MINUTES=360
# SNAPSHOT_MIN_INTERVAL_MINUTES=60
